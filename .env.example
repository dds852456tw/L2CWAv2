# ─────────────────────────────────────────────────────────────────────────────
# L2CWAv2 環境變數設定
# 複製此檔案為 .env 並填入你的實際金鑰
# ─────────────────────────────────────────────────────────────────────────────

# CWA 開放資料平台 API Key
# 申請：https://opendata.cwa.gov.tw/
CWA_API_KEY=

# LINE Bot Channel Secret
# 取得：https://developers.line.biz/console/
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Bot Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Streamlit / Web 地圖服務公開 URL
STREAMLIT_MAP_URL=https://dds852456tw.github.io/L2CWAv2/
